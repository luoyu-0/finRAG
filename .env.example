# 默认仅监听本机。部署到服务器并配置防火墙、反向代理后，可改为 0.0.0.0。
BIND_HOST=127.0.0.1
TZ=Asia/Shanghai
APP_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=finrag
MYSQL_USER=finrag
MYSQL_PASSWORD=change_me_app
MYSQL_HOST_PORT=3306

# 首次启动时设置；管理员建成后可从 .env 删除初始密码并重启服务。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
# 至少 32 字符的随机密钥；正式环境必须使用独立密钥。
JWT_SECRET_KEY=

# Milvus 与 MinIO
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 应用端口
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 留空时仍可登录，但问答返回 RAG_RETRIEVAL_UNAVAILABLE。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
