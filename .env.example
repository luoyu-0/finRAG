# 默认仅监听本机。部署到服务器并配置防火墙、反向代理后，可改为 0.0.0.0。
BIND_HOST=127.0.0.1
TZ=Asia/Shanghai
APP_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=finrag
MYSQL_USER=finrag
MYSQL_PASSWORD=change_me_app
MYSQL_HOST_PORT=3306

# 新数据库默认创建 admin / finrag2026；已有 admin 若密码不同，启动时同步并撤销旧刷新会话。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=finrag2026
# 本地开发留空时使用固定开发密钥；正式环境必须配置独立密钥。
JWT_SECRET_KEY=

# Milvus 与 MinIO
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 应用端口
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 外部模型服务；检索与生成 Provider 未接入前可以留空。
DEEPSEEK_API_KEY=
