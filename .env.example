# 默认仅监听本机。部署到服务器并配置防火墙、反向代理后，可改为 0.0.0.0。
BIND_HOST=127.0.0.1
TZ=Asia/Shanghai
APP_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=finrag
MYSQL_USER=finrag
MYSQL_PASSWORD=change_me_app
MYSQL_HOST_PORT=3306

# Milvus 与 MinIO
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 应用端口
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 外部模型服务；未开发问答逻辑前可以留空。
DEEPSEEK_API_KEY=
